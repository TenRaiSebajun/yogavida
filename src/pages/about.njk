       ABOUT SHANNEL
       ═══════════════════════════════════════════ -->
  <section class="section" id="shannel">
    <div class="container">
      <div class="media-text">
        <div class="media-text__image reveal reveal--left">
          <img src="https://yogavidawellness.com/wp-content/uploads/2022/10/Padma-mudra-768x1024.jpg"
               alt="Shannel in Padma mudra"
               loading="lazy">
        </div>
        <div class="media-text__content reveal reveal--right">
          <p class="media-text__label" data-editable="source" data-path="/src/pages/about.njk" data-key="shannel_label">Your Teacher</p>
          <h2 class="media-text__title" data-editable="source" data-path="/src/pages/about.njk" data-key="shannel_name">Shannel Jani</h2>
          <p class="media-text__body" data-editable="source" data-path="/src/pages/about.njk" data-key="shannel_bio_1">
            Shannel is a multi-disciplined yoga practitioner of over 18 years. Originally from the UK, growing up in East Africa, she has travelled extensively through South America, Southern Asia, Central Asia, Australia and Bali. Having recently relocated to Dubai, UAE, Shannel continues to share her passion for yoga, meditation and holistic wellness.
          </p>
          <p class="media-text__body" data-editable="source" data-path="/src/pages/about.njk" data-key="shannel_bio_2">
            Shannel holds a 200hr YTTC from Sampoorna Yoga School in Goa, India and is qualified in Hatha, Vinyasa Flow, Ashtanga, Yin, Restorative Yoga, Children's Yoga, Pre &amp; Post Natal, Fertility and Women's Health Yoga, as well as Guided Meditation and Ayurvedic Dosha consultation.
          </p>
        </div>
      </div>
    </div>
  </section>


