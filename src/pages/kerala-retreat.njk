<!-- FAQ -->
<section id="faq" class="section">
  <div class="container">
    <div class="section-header reveal">
      <p class="section-header__label" data-editable="source" data-path="/src/pages/kerala-retreat.njk" data-key="faq_label">Questions</p>
      <h2 class="section-header__title" data-editable="source" data-path="/src/pages/kerala-retreat.njk" data-key="faq_title">Frequently Asked</h2>
      <div class="section-header__line"></div>
    </div>

    <div class="accordion reveal">
      <div class="accordion__item">
        <button class="accordion__trigger" data-editable="source" data-path="/src/pages/kerala-retreat.njk" data-key="faq_q1">
          Do I need prior yoga experience?
          <span class="accordion__icon"></span>
        </button>
        <div class="accordion__body">
          <div class="accordion__content" data-editable="source" data-path="/src/pages/kerala-retreat.njk" data-key="faq_a1">
            Not at all. The retreat welcomes all levels, from complete beginners to experienced
            practitioners. All sessions are adapted to meet you where you are.
          </div>
        </div>
      </div>

      <div class="accordion__item">
        <button class="accordion__trigger" data-editable="source" data-path="/src/pages/kerala-retreat.njk" data-key="faq_q2">
          What kind of food is provided?
          <span class="accordion__icon"></span>
        </button>
        <div class="accordion__body">
          <div class="accordion__content" data-editable="source" data-path="/src/pages/kerala-retreat.njk" data-key="faq_a2">
            All meals are Ayurvedic, vegetarian and sattvic — freshly prepared with locally sourced
            ingredients. The food is gentle, nourishing and not overly spiced. Special dietary
            requirements can be accommodated.
          </div>
        </div>
      </div>

      <div class="accordion__item">
        <button class="accordion__trigger" data-editable="source" data-path="/src/pages/kerala-retreat.njk" data-key="faq_q3">
          What should I expect from the accommodation?
          <span class="accordion__icon"></span>
        </button>
        <div class="accordion__body">
          <div class="accordion__content" data-editable="source" data-path="/src/pages/kerala-retreat.njk" data-key="faq_a3">
            The resort offers comfortable 3-star standard accommodation. All rooms have en-suite
            bathrooms, air conditioning and free wi-fi. The setting is peaceful and traditional,
            surrounded by coconut palms and tropical gardens.
          </div>
        </div>
      </div>

      <div class="accordion__item">
        <button class="accordion__trigger" data-editable="source" data-path="/src/pages/kerala-retreat.njk" data-key="faq_q4">
          How many guests will be on the retreat?
          <span class="accordion__icon"></span>
        </button>
        <div class="accordion__body">
          <div class="accordion__content" data-editable="source" data-path="/src/pages/kerala-retreat.njk" data-key="faq_a4">
            The retreat is limited to a maximum of 25 guests to ensure a personal,
            intimate experience with plenty of individual attention.
          </div>
        </div>
      </div>

      <div class="accordion__item">
        <button class="accordion__trigger" data-editable="source" data-path="/src/pages/kerala-retreat.njk" data-key="faq_q5">
          Can I attend solo?
          <span class="accordion__icon"></span>
        </button>
        <div class="accordion__body">
          <div class="accordion__content" data-editable="source" data-path="/src/pages/kerala-retreat.njk" data-key="faq_a5">
            Absolutely. Many of our guests come solo. It's a wonderful opportunity to meet
            like-minded people in a supportive, welcoming environment. Single-occupancy
            rooms are available.
          </div>
        </div>
      </div>

      <div class="accordion__item">
        <button class="accordion__trigger" data-editable="source" data-path="/src/pages/kerala-retreat.njk" data-key="faq_q6">
          What is the payment schedule?
          <span class="accordion__icon"></span>
        </button>
        <div class="accordion__body">
          <div class="accordion__content" data-editable="source" data-path="/src/pages/kerala-retreat.njk" data-key="faq_a6">
            A non-refundable deposit of &pound;500 is required to secure your place. The remaining
            balance is due by 21 September 2026 (2 months before the retreat). Confirmation
            will be sent within 48 hours of your booking.
          </div>
        </div>
      </div>

      <div class="accordion__item">
        <button class="accordion__trigger" data-editable="source" data-path="/src/pages/kerala-retreat.njk" data-key="faq_q7">
          What are the check-in and check-out times?
          <span class="accordion__icon"></span>
        </button>
        <div class="accordion__body">
          <div class="accordion__content" data-editable="source" data-path="/src/pages/kerala-retreat.njk" data-key="faq_a7">
            Check-in is from 12 noon and check-out is by 10am. Early arrival or extra nights
            may be arranged subject to availability.
          </div>
        </div>
      </div>

      <div class="accordion__item">
        <button class="accordion__trigger" data-editable="source" data-path="/src/pages/kerala-retreat.njk" data-key="faq_q8">
          What should I pack?
          <span class="accordion__icon"></span>
        </button>
        <div class="accordion__body">
          <div class="accordion__content" data-editable="source" data-path="/src/pages/kerala-retreat.njk" data-key="faq_a8">
            A detailed packing list will be provided after booking. In general, pack light,
            comfortable clothing for yoga and warm weather, a reusable water bottle,
            sunscreen, insect repellent and any personal items you need.
          </div>
        </div>
      </div>

      <div class="accordion__item">
        <button class="accordion__trigger" data-editable="source" data-path="/src/pages/kerala-retreat.njk" data-key="faq_q9">
          What is the cancellation policy?
          <span class="accordion__icon"></span>
        </button>
        <div class="accordion__body">
          <div class="accordion__content" data-editable="source" data-path="/src/pages/kerala-retreat.njk" data-key="faq_a9">
            Cancellations made 60+ days before the retreat receive a full refund minus the &pound;500
            deposit. Cancellations within 60 days of the retreat are non-refundable. If the retreat
            is cancelled by the hosts, you will receive a full refund including deposit. We strongly
            recommend taking out travel insurance.
          </div>
        </div>
      </div>
    </div>
  </div>
</section>


